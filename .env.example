# Extra folder searched for .vst3 bundles (the standard Windows/macOS/Linux VST3 folders are always searched)
NEURAL_DSP_VST3_DIR=C:\Program Files\Common Files\VST3\Neural DSP
# Where schemas are written / read (default: config/plugin_schemas)
PLUGIN_SCHEMA_DIR=config/plugin_schemas

# Optional: lets `--llm` / use_llm=True ask Claude to refine the heuristic preset
ANTHROPIC_API_KEY=
# Hybrid engine's Claude stage: "cli" (the logged-in `claude` CLI, no API key), "api" (needs ANTHROPIC_API_KEY),
# or empty = api when a key is set, else cli
NEURAL_TONE_CLAUDE_BACKEND=
# Full path to the claude executable if it is not on PATH
CLAUDE_CLI_PATH=
# Optional: model for that refinement (default claude-sonnet-5-5)
NEURAL_TONE_MODEL=
# Optional: ffmpeg binary (otherwise PATH, then the one bundled with imageio-ffmpeg)
FFMPEG_PATH=
# REAPER bridge folder (must match the reaper-mcp Lua script)
REAPER_MCP_BRIDGE_DIR=
# Hybrid engine: Gemini listens to the audio when Claude's render is off by more than 2 dB (GOOGLE_API_KEY also works)
GEMINI_API_KEY=
# Optional: pin the Gemini model (default gemini-pro-latest, which needs a billing-enabled key;
# free-tier keys: gemini-flash-latest. gemini-2.5-pro is closed to new keys)
GEMINI_MODEL=
# Guitar stem separation: cascade (default; 4-stem model first, then htdemucs_6s) or single (one htdemucs_6s pass, ~2x faster)
NEURAL_TONE_SEPARATION=
# Optional quality knobs: test-time shifts (each adds a full pass) and chunk overlap (default 0 and 0.25)
NEURAL_TONE_SHIFTS=
NEURAL_TONE_OVERLAP=
